/*
========================================================================================
    nextflow.config — Main configuration for the CellRanger_Flow pipeline
========================================================================================
        Available profiles:
            -profile slurm        -> SLURM submission (can be combined with singularity)
========================================================================================
*/

// ========================================================================================
// GLOBAL PARAMETERS (overridable via CLI)
// ========================================================================================

params {

    // --- Inputs ---
    run_id             = null // See if run_ID is format H155HGF51 (FlowCellID) or 260323_A01789_0447_AHCHNTDMX2 (CelineID) (I think FlowCellID HCHNTDMX2 is better)
    raw_sample_sheet_file_path = null // Path to the original sample sheet (required in BCL mode)
    bcl_dir            = "/sequenceurs/NovaSeq1/${params.run_id}" // Path to the BCL directory (required in BCL mode)
    genome_reference   = "/labos/UGM/dev/cellranger-pipe/refdata-gex-GRCh38-2020-A" // Path to pre-built Cell Ranger genome
    vdj_reference      = "/labos/UGM/dev/cellranger-pipe/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.0.0" // Path to pre-built Cell Ranger VDJ reference 
    config_template    = "/Data/Sample_sheet/Template/config_template.csv" // Path to the Cell Ranger count config template (YAML)
    protocol_prefix    = "protocol_prefix" // Prefix used to build full batch names
    batch_ids          = "batch1,batch2,batch3" // Comma-separated values csv in a string of batch numbers (e.g. 74,75,76)
    path_ref_gex       = "/labos/UGM/dev/cellranger-pipe/refdata-gex-GRCh38-2020-A" // GEX reference
    path_ref_vdj       = "/labos/UGM/dev/cellranger-pipe/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.0.0" // VDJ reference
    path_fastq         = "/labos/UGM/Recherche/midas/fastq2" // FASTQ base directory
    fastq_folder_gex   = "${params.run_id}" // FASTQ subfolder containing GEX files
    fastq_folder_vdj   = "${params.run_id}" // FASTQ subfolder containing VDJ files

    // --- Outputs ---
    output_dir         = "${launchDir}/results/${params.run_id}" // Base output directory (created if doesn't exist)
    preprocessing_output_dir = "${params.output_dir}/preprocessed_sample_sheet" // Directory for the modified sample sheet (generated by PREPROCESSING)
    qc_output_dir = "${params.output_dir}/qc" // Directory for Cell Ranger mkfastq outputs
    alignment_output_dir   = "${params.output_dir}/alignment" // Directory for Cell Ranger count outputs
    multiqc_output_dir = "${params.output_dir}/multiqc" // Directory for MultiQC outputs

    // --- Logs ---
    log_dir             = "${launchDir}/logs/${params.run_id}/" // Directory for logs (created if doesn't exist)
    preprocessing_log_dir = "${params.log_dir}/preprocessing" // Directory for preprocessing logs
    qc_log_dir       = "${params.log_dir}/qc" // Directory for QC logs (e.g., MultiQC)
    alignment_log_dir      = "${params.log_dir}/alignment" // Directory for alignment logs (e.g., Cell Ranger)
    multiqc_log_dir      = "${params.log_dir}/multiqc" // Directory for MultiQC logs
    trace_log_file       = "${params.log_dir}/pipeline_trace.txt" // File for Nextflow trace logs

    // --- Cell Ranger resources ---
    localcores         = 16               // Number of CPUs allocated to Cell Ranger
    localmemory        = 64              // RAM allocated in GB

    // --- Cell Ranger count options ---
    chemistry          = 'auto'           // ex: 'SC3Pv3', 'SC5P-PE', 'auto'
    expect_cells       = 5000             // Expected number of cells per sample
    include_introns    = true             // Include introns (pre-mRNA)
    force_cells        = null             // Force a specific number of cells (optional)

    // --- Options MultiQC ---
    multiqc_config     = "${projectDir}/assets/multiqc_config.yaml"
    multiqc_title      = 'Cell Ranger Flow MultiQC Report'

    // --- Traceability ---
    enable_conda       = false            // Conda disabled (use Docker/Singularity)

    // --- Pipeline metadata ---
    pipeline_version   = '1.0.0'
    min_nextflow_version = '23.10.0'
}

// ========================================================================================
// NEXTFLOW VERSION VALIDATION
// ========================================================================================

// Ensure the user is running a compatible Nextflow version
//if (nextflow.version.toString().tokenize('.').collect { it.toInteger() } <
//    params.min_nextflow_version.tokenize('.').collect { it.toInteger() }) {
//        error "This pipeline requires Nextflow >= ${params.min_nextflow_version}. " +
//            "Current version: ${nextflow.version}. Please update Nextflow."
//}

// ========================================================================================
// DEFAULT PROCESS CONFIGURATION
// ========================================================================================

process {

    // Retry policy on failure
    //errorStrategy = { task.exitStatus in [130, 137, 139, 143] ? 'retry' : 'finish' }
    //maxRetries    = 2
    //maxErrors     = '-1'

    // -----------------------------------------------------------------------
    // RESOURCE LABELS (used in modules)
    // -----------------------------------------------------------------------

    // Default resources (overridden by labels below)
    cpus   = 2
    memory = '8.GB'
    time   = '2.h'

    // Resources based on process labels (defined in modules) :
    // Process tag as "process low"
    withLabel: 'process_low' {
        cpus   = 2
        memory = '8.GB'
        time   = '2.h'
    }

    // Process tag as "process medium"
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32.GB'
        time   = '6.h'
    }

    // Process tag as "process high"
    withLabel: 'process_high' {
        cpus   = { params.localcores }
        memory = { "${params.localmemory}.GB" }
        time   = '24.h'
    }

    // Process tag as "process high_memory" (for memory-intensive steps)
    withLabel: 'process_high_memory' {
        cpus   = { params.localcores }
        memory = { "${params.localmemory * 2}.GB" }
        time   = '48.h'
    }

    // -----------------------------------------------------------------------
    // CONTAINERS PER PROCESS (pinned versions)
    // -----------------------------------------------------------------------

    // Cell Ranger v7.2.0 (pinned version for reproducibility)
    withName: 'CELLRANGER_MKFASTQ' {
        container = 'nfcore/cellranger:7.2.0'
    }

    // Cell Ranger v7.2.0 (pinned version for reproducibility)
    withName: 'CELLRANGER_COUNT' {
        container = 'nfcore/cellranger:7.2.0'
    }

    // MultiQC v1.21 (pinned version for reproducibility)
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
}

// ========================================================================================
// EXECUTION PROFILES
// ========================================================================================

profiles {

    // -----------------------------------------------------------------------
    // DOCKER PROFILE (development / CI)
    // -----------------------------------------------------------------------
    //docker {
    //    docker.enabled         = true
    //    docker.runOptions      = '-u $(id -u):$(id -g)'
    //    docker.userEmulation   = true
    //    singularity.enabled    = false
    //    conda.enabled          = false

    //    process {
            // Automatically mount the working directory
    //        containerOptions   = "--volume ${launchDir}:${launchDir}"
    //    }
    //}

    // -----------------------------------------------------------------------
    // SINGULARITY PROFILE (HPC)
    // -----------------------------------------------------------------------
    //singularity {
    //    singularity.enabled    = true
    //    singularity.autoMounts = true
    //    singularity.runOptions = "--bind ${launchDir}:${launchDir}"
    //    docker.enabled         = false
    //    conda.enabled          = false

        // Singularity image cache (avoids repeated downloads)
    //    singularity.cacheDir   = "${launchDir}/.singularity_cache"
    //}

    // -----------------------------------------------------------------------
    // SLURM PROFILE (HPC submission via SLURM)
    // Combine with singularity: -profile slurm,singularity
    // -----------------------------------------------------------------------
    slurm {
        conda {
            enabled = true
        }

        process {
            
            // Define the resource manager
            executor       = 'slurm'

            // SLURM partition
            queue          = 'phoenix'

            // SLURM resources limits (overridden by labels in modules)
            resourceLimits = [
                cpus : 16,
                memory : 48.GB,
                time : 144.h
            ]

            // Others SLURM options (e.g., account, qos)
            // clusterOptions = '--account=myproject'

        }
    }

    // -----------------------------------------------------------------------
    // TEST PROFILE (pipeline validation without real data)
    // -----------------------------------------------------------------------
    //test {
    //    params {
    //        input_type       = 'fastq'
    //        input_dir        = "${projectDir}/test_data/fastq"
    //        output_dir       = "${launchDir}/test_results"
    //        genome_reference = "${projectDir}/test_data/genome_ref"
    //        sample_sheet     = "${projectDir}/test_data/sample_sheet.csv"
    //        localcores       = 4
    //        localmemory      = 16
    //        expect_cells     = 500
    //    }

    //    process {
    //        cpus   = 4
    //        memory = '16.GB'
    //        time   = '2.h'
    //    }
    //}
}

// ========================================================================================
// REPORTS AND TRACEABILITY
// ========================================================================================

// Controls the generation of the Execution timeline.
timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/pipeline_timeline.html"
}

// Controls the generation of the execution report (summary of processes, resources, etc.)
report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/pipeline_report.html"
}

// Controls the generation of the execution trace (detailed log of each task)
trace {
    enabled        = true
    overwrite      = true
    file           = "${launchDir}/pipeline_trace.txt"
    fields         = 'task_id,hash,native_id,process,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

// Controls the generation of the DAG (Directed Acyclic Graph) of the workflow execution
dag {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/pipeline_dag.html"
}

// ========================================================================================
// GLOBAL NEXTFLOW ENGINE CONFIGURATION
// ========================================================================================

// Global configuration for the Nextflow engine
manifest {
    name            = 'CellRanger_Flow'
    author          = 'Jordan Dutel'
    //affiliation     = 'CRCT - Centre de Recherche en Cancérologie de Toulouse'
    homePage        = 'https://jordandutel.com/'
    //github          = 'https://github.com/jdutel42/cellranger-flow'
    description     = 'Pipeline Single-Cell 10x Genomics (BCL/FASTQ → Cell Ranger → MultiQC)'
    mainScript      = 'main.nf'
    nextflowVersion = ">=23.10.0"
    version         = '1.0.0'
}

// Disable default plugin cache to ensure reproducibility between runs
plugins {
    id 'nf-validation@1.1.3'
}
